APP_NAME="Tesora"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production (Hostinger): APP_URL=https://www.tesora.com.br

APP_TIMEZONE=America/Sao_Paulo

# FTP for local deploy scripts only — set in .env, not on server (HostGator Brazil)
HOSTINGER_FTP_HOST=192.185.212.97
HOSTINGER_FTP_USER=fulvio@fulviolopescatto1787174444000.0970020.meusitehostgator.com.br
HOSTINGER_FTP_PASSWORD=
# Remote FTP prefix: empty on HostGator (laravel/ + public_html/ at account root).
# Legacy Hostinger: domains/tesora.com.br
HOSTINGER_FTP_REMOTE_BASE=
# Prefer shared IP (from cPanel → Informações Gerais) over ftp.* hostname (Cloudflare blocks port 21).
# Until tesora.com.br DNS points to HostGator, run deploy helpers on the temp URL:
# TESORA_SITE_BASE=http://fulviolopescatto1787174444000.0970020.meusitehostgator.com.br

# Site owner email(s), comma-separated — grants access to /paineldecontrole
ADMIN_EMAIL=fulvio.catto@hotmail.com
ADMIN_PASSWORD=
# Optional public profile username (defaults to email local part)
# ADMIN_USERNAME=fulvio-catto
# ADMIN_NAME=Super Admin

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Production on Hostinger: DB_HOST=localhost
# Local dev via Remote MySQL: DB_HOST=<hostname from hPanel → Remote MySQL>
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fulvio54_tesora
DB_USERNAME=fulvio54_admin
DB_PASSWORD=
# Remote MySQL: hPanel → tesora.com.br → Remote MySQL → whitelist your IP, select database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tesora.com.br
# Pin cookie name so renaming APP_NAME does not break Google OAuth state.
SESSION_COOKIE=smart-barbeiro-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production (Hostinger mailbox) example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=sac@tesora.com.br
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="sac@tesora.com.br"
# MAIL_FROM_NAME="Tesora"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=BRL
# Use "local" on Windows/dev when PHP has no CA bundle; use "server" in production
MERCADOPAGO_RUNTIME=local
# HTTPS public URL for MP subscription return (required). Local options:
# - Cloudflare: run scripts/start-dev-tunnel.ps1 and paste the trycloudflare.com URL
# - ngrok: ngrok http 8000 (requires free account + authtoken)
# - Production: https://www.tesora.com.br
MERCADOPAGO_BACK_URL=

# Stripe — client → barbershop service plan subscriptions (mobile + web checkout)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
STRIPE_MERCHANT_DISPLAY_NAME="${APP_NAME}"
STRIPE_APPLE_PAY_MERCHANT_ID=
# true while using pk_test_/sk_test_; set false when switching to live keys
STRIPE_GOOGLE_PAY_TEST_ENV=true
# Pix Automático on subscription Checkout (enable Pix in Stripe Dashboard too)
STRIPE_PIX_ENABLED=true
# Marketplace: destination charges to each barbershop Express account
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_COUNTRY=BR
STRIPE_APPLICATION_FEE_PERCENT=10

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to {APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# Mobile app store links (shown on barbershop plan builder for phone visitors)
MOBILE_APP_NAME="Tesora"
# Defaults to Play Store listing for com.smartbarbeiro.client when unset
# MOBILE_APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.smartbarbeiro.client
MOBILE_APP_APP_STORE_URL=
