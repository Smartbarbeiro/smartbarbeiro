# Production .env template for tesora.com.br (HostGator Brazil).
# Copy to laravel/.env on the server, then run patch-production-secrets-tesora.php
# from deploy or fill secrets manually in cPanel File Manager.

APP_NAME="Tesora"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tesora.com.br

APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Auto-detected by env-setup / patch scripts (realpath of public_html)
PUBLIC_PATH=

ADMIN_EMAIL=fulviolopescatto@gmail.com
ADMIN_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fulvio54_tesora
DB_USERNAME=fulvio54_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.tesora.com.br
SESSION_COOKIE=smart-barbeiro-session

QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_LEVEL=error

# HostGator mailbox (cPanel → Email Accounts → atendimento@tesora.com.br)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.tesora.com.br
MAIL_PORT=465
MAIL_USERNAME=atendimento@tesora.com.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="atendimento@tesora.com.br"
MAIL_FROM_NAME="Tesora"

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=BRL
MERCADOPAGO_RUNTIME=server
MERCADOPAGO_BACK_URL=https://www.tesora.com.br

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.tesora.com.br/oauth-google-return.php

STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CURRENCY=brl
STRIPE_MERCHANT_DISPLAY_NAME="Tesora"
STRIPE_GOOGLE_PAY_TEST_ENV=true
STRIPE_PIX_ENABLED=true
